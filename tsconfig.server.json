{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "allowImportingTsExtensions": false
  },
  "include": [
    "src/cli.ts",
    "src/runtime/**/*.ts",
    "src/server/**/*.ts",
    "src/shared/**/*.ts",
    "src/state/**/*.ts"
  ]
}
